{
  "name": "branzzo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "test": "playwright test tests/public/analytics-formulas.spec.ts tests/public/payment-security.spec.ts tests/public/cloudflare-mongodb.spec.ts tests/public/index-deployment.spec.ts tests/email/email-foundation.spec.ts tests/auth/clerk-security.spec.ts --config=playwright.analytics-unit.config.ts",
    "test:integration": "playwright test tests/public/analytics-db.integration.spec.ts tests/public/admin-search.integration.spec.ts tests/email/email-delivery.integration.spec.ts tests/auth/clerk-sync.integration.spec.ts --config=playwright.analytics-unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:adapt": "opennextjs-cloudflare build --skipNextBuild",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "cf:staging:build": "opennextjs-cloudflare build --config wrangler.staging.jsonc",
    "cf:staging:adapt": "opennextjs-cloudflare build --config wrangler.staging.jsonc --skipNextBuild",
    "cf:staging:dry-run": "wrangler deploy --config wrangler.staging.jsonc --dry-run --outdir .wrangler-dry-run-staging",
    "cf:staging:preflight": "node scripts/validate-staging-environment.mjs",
    "cf:startup": "wrangler check startup",
    "cf:preview": "wrangler dev",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "ci:check": "npm audit --omit=dev --audit-level=high && npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build && npm run cf:adapt && npm run cf:dry-run",
    "start": "next start",
    "start:e2e": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:wizard": "tsx scripts/check-brand-inquiry-wizard.ts",
    "db:check": "tsx scripts/check-db.ts",
    "migrate:analytics": "tsx scripts/migrate-analytics.ts",
    "indexes:analytics": "tsx scripts/deploy-analytics-indexes.ts",
    "indexes:analytics:apply": "tsx scripts/deploy-analytics-indexes.ts --apply",
    "indexes:pagination": "tsx scripts/verify-pagination-indexes.ts",
    "indexes:pagination:apply": "tsx scripts/verify-pagination-indexes.ts --apply",
    "indexes:public-performance": "tsx scripts/deploy-public-performance-indexes.ts",
    "indexes:public-performance:apply": "tsx scripts/deploy-public-performance-indexes.ts --apply",
    "explain:pagination": "tsx scripts/explain-pagination.ts",
    "explain:analytics": "tsx scripts/explain-analytics.ts",
    "indexes:email": "tsx scripts/verify-email-indexes.ts",
    "reconcile:clerk": "tsx scripts/reconcile-clerk-users.ts",
    "indexes:clerk-sync": "tsx scripts/verify-clerk-sync-indexes.ts",
    "branding:generate": "node scripts/generate-branding-assets.mjs",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.8",
    "@react-email/render": "2.0.9",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "framer-motion": "12.42.2",
    "lucide-react": "1.21.0",
    "mongodb": "7.3.0",
    "mongoose": "9.7.2",
    "next": "15.5.22",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.16.0",
    "svix": "1.96.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.61.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  }
}
